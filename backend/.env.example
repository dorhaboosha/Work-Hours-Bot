# Local development (matches docker-compose.yml)
DATABASE_URL=postgresql://workhours:workhours_password@localhost:5435/workhours_bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Your numeric Telegram user ID (not @username). Every message from anyone
# else is silently ignored. Get yours by messaging https://t.me/userinfobot
OWNER_TELEGRAM_ID=
NODE_ENV=development
PORT=3000

# Production: the app runs on Render, the database on Neon — set DATABASE_URL to the
# Neon connection string and NODE_ENV=production; PORT is injected by Render.
# Use a separate dev bot token locally: running with the production token while
# production is up makes the two instances fight over messages (409 Conflict).
