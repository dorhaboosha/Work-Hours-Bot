# Local development (matches docker-compose.yml)
DATABASE_URL=postgresql://workhours:workhours_password@localhost:5435/workhours_bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Your numeric Telegram user ID (not @username). Every message from anyone
# else is silently ignored. Get yours by messaging https://t.me/userinfobot
OWNER_TELEGRAM_ID=
NODE_ENV=development
PORT=3000
# Required by every /api/* request as the X-API-Key header. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Production (Render): use Internal Database URL, NODE_ENV=production; PORT is injected by Render
