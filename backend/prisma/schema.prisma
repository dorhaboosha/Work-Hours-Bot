generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserSettings {
  id                   String   @id @default(uuid())
  telegramId           String   @unique @map("telegram_id")
  dailyRequiredMinutes Int      @map("daily_required_minutes")
  timezone             String
  workdays             Int[]

  // Leave accrual (vacation/sick balance tracking)
  vacationAccrualRate   Float     @default(1)   @map("vacation_accrual_rate")
  sickAccrualRate       Float     @default(1.5) @map("sick_accrual_rate")
  vacationBalance       Float     @default(0)   @map("vacation_balance")
  sickBalance           Float     @default(0)   @map("sick_balance")
  // Internal bookkeeping for lazy monthly accrual catch-up; not exposed to users.
  accrualAnchorAt       DateTime? @map("accrual_anchor_at")
  accrualAppliedThrough DateTime? @map("accrual_applied_through")

  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}

enum DailyRecordType {
  WORK
  SICK
  VACATION
  HOLIDAY
  HOLIDAY_EVE
  UNPAID_ABSENCE
  ELECTION
}

model DailyRecord {
  id              String          @id @default(uuid())
  telegramId      String          @map("telegram_id")
  workDate        DateTime        @map("work_date") @db.Date
  recordType      DailyRecordType @default(WORK) @map("record_type")
  startTime       DateTime?       @map("start_time")
  expectedEndTime DateTime?       @map("expected_end_time")
  endTime         DateTime?       @map("end_time")
  workedMinutes   Int?            @map("worked_minutes")

  // Leave balance debited for this record, if any ("vacationBalance" |
  // "sickBalance" | null). Lets a later edit that changes/removes the
  // absence type refund exactly what this record previously debited.
  debitedLeaveField String? @map("debited_leave_field")
  debitedLeaveDays  Float?  @map("debited_leave_days")

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([telegramId, workDate])
  @@index([telegramId])
  @@index([telegramId, workDate])
  @@index([telegramId, recordType])
  @@index([telegramId, endTime])
  @@map("daily_records")
}
