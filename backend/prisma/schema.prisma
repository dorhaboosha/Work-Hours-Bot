generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserSettings {
  id                   String   @id @default(uuid())
  telegramId           String   @unique @map("telegram_id")
  dailyRequiredMinutes Int      @map("daily_required_minutes")
  // Required minutes on Chol HaMoed days (Sukkot/Pesach). null = same as
  // dailyRequiredMinutes.
  cholHamoedRequiredMinutes Int? @map("chol_hamoed_required_minutes")
  timezone             String
  workdays             Int[]

  // Leave accrual (vacation/sick balance tracking)
  vacationAccrualRate   Float     @default(1)   @map("vacation_accrual_rate")
  sickAccrualRate       Float     @default(1.5) @map("sick_accrual_rate")
  vacationBalance       Float     @default(0)   @map("vacation_balance")
  sickBalance           Float     @default(0)   @map("sick_balance")
  // Internal bookkeeping for lazy monthly accrual catch-up; not exposed to users.
  accrualAnchorAt       DateTime? @map("accrual_anchor_at")
  accrualAppliedThrough DateTime? @map("accrual_applied_through")

  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}

enum DailyRecordType {
  WORK
  SICK
  VACATION
  HOLIDAY
  HOLIDAY_EVE
  UNPAID_ABSENCE
  ELECTION
}

/// How much of the day an absence record covers. HALF leaves the other half
/// open for logged work hours (for HOLIDAY_EVE: HALF = the non-company half
/// was worked, FULL = it was taken as vacation).
enum AbsencePortion {
  FULL
  HALF
}

model DailyRecord {
  id              String          @id @default(uuid())
  telegramId      String          @map("telegram_id")
  workDate        DateTime        @map("work_date") @db.Date
  recordType      DailyRecordType @default(WORK) @map("record_type")
  // null for WORK records.
  absencePortion  AbsencePortion? @map("absence_portion")
  startTime       DateTime?       @map("start_time")
  expectedEndTime DateTime?       @map("expected_end_time")
  endTime         DateTime?       @map("end_time")
  // Actual worked minutes only (from start/end times). 0 for full-day absences.
  workedMinutes   Int?            @map("worked_minutes")
  // Minutes credited by an absence (leave or company-paid time), snapshotted
  // when the absence is marked. A day's total = creditedMinutes + workedMinutes.
  creditedMinutes Int             @default(0) @map("credited_minutes")

  // Leave balance debited for this record, if any ("vacationBalance" |
  // "sickBalance" | null). Lets a later edit that changes/removes the
  // absence type refund exactly what this record previously debited.
  debitedLeaveField String? @map("debited_leave_field")
  debitedLeaveDays  Float?  @map("debited_leave_days")

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // The unique constraint below already provides an index on [telegramId,
  // workDate] (and, via its leading column, on telegramId alone), covering
  // findRecordByDate/listRecordsByRange — no separate index needed for those.
  @@unique([telegramId, workDate])
  // Covers findOpenWorkRecord's `WHERE telegramId = ? AND endTime IS NULL`.
  // Not keyed on recordType: a half-day absence record can also hold an
  // open work session.
  @@index([telegramId, endTime])
  @@map("daily_records")
}
